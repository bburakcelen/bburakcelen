{
  "name": "twoside-boys-animation",
  "version": "1.0.0",
  "private": true,
  "description": "TwoSide Boys kanal tan\u0131t\u0131m videosu \u2014 Remotion ile karikat\u00fcr animasyon",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "timeline": "tsx scripts/timeline.mts",
    "timeline:md": "tsx scripts/timeline.mts --md",
    "render": "remotion render Master out/TwoSideBoys.mp4",
    "render:4k": "remotion render Master out/TwoSideBoys-4k.mp4 --scale=2",
    "render:prores": "remotion render Master out/TwoSideBoys.mov --codec=prores --prores-profile=4444",
    "render:clips": "node scripts/render-all.mjs --video",
    "render:clips:4k": "node scripts/render-all.mjs --video --scale=2",
    "render:frames": "node scripts/render-all.mjs",
    "typecheck": "tsc --noEmit",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/animation-utils": "4.0.526",
    "@remotion/cli": "4.0.526",
    "@remotion/noise": "4.0.526",
    "@remotion/paths": "4.0.526",
    "@remotion/shapes": "4.0.526",
    "@remotion/transitions": "4.0.526",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.526"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
